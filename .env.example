# Earth Stories — environment variables
#
# Server-side only. Deliberately NOT prefixed with VITE_: any VITE_* variable is
# inlined into the client bundle and handed to every visitor. This key is read
# by api/narrate.js (in production) and by the vite dev middleware (locally).
GROQ_API_KEY=your_groq_api_key_here

# Google Earth Engine project used by the data pipeline (data-pipeline/).
EE_PROJECT=earth-stories-hackathon
